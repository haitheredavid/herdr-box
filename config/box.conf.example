# herdr-box host config: copy to config/box.conf (git-ignored) and edit.
# Sourced by bootstrap/bootstrap.sh as POSIX sh.

# The one account on the box. Its SSH public key(s) go in config/authorized_keys
# (copy config/authorized_keys.example).
BOX_USER="me"

# Login shell: bash or zsh.
BOX_SHELL="bash"

# Optional dotfiles repo, set up for BOX_USER at every boot (empty: no dotfiles).
# It lives at ~/projects/dotfiles: seeded from /opt/dotfiles when the image's base
# provides one (terraform dotfiles_dir), else cloned from DOTFILES_REPO. Then
# DOTFILES_SETUP (a path inside the repo) runs as BOX_USER; it must be idempotent.
DOTFILES_REPO=""
DOTFILES_SETUP="linux/setup.sh"

# Optional shared llama.cpp server (scripts/llm.sh on the Mac that hosts it), as
# http://<tailnet-host>:<port>. Exported to every shell and terminal as
# LLAMA_CPP_BASE_URL, where omp discovers it (empty: none).
LLAMA_CPP_URL=""
